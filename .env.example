# StudioSpace backend configuration
# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB connection string
MONGO_URI=

# BetterAuth signing secret - generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Optional: Google OAuth social login (until provided, Google button stays disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: server port (defaults to 5000)
# PORT=5000
